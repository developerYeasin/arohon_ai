PORT=5000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=arohon_ai

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Optional: enables the LLM-powered AI Coach. Without it the coach uses the built-in rule engine.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# ---------- Payments ----------
# Development only: shows a "demo payment" button that activates a plan instantly (ignored when NODE_ENV=production).
PAYMENT_DEMO=false
# Where bKash sends the customer back to (must be reachable by the customer's browser).
API_PUBLIC_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
# bKash Tokenized Checkout — sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta · live: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Manual "Send Money" numbers (a method is shown only when its number is set)
MANUAL_BKASH_NUMBER=
MANUAL_NAGAD_NUMBER=
MANUAL_ROCKET_NUMBER=
# ---------- Password-reset codes ----------
# Email (SMTP). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS: any bulk-SMS HTTP GET API with {to} and {message} placeholders. Empty = disabled.
SMS_API_URL=
# ---------- Seed / demo accounts (used by `npm run seed`) ----------
SEED_ADMIN_EMAIL=admin@arohon.ai
SEED_ADMIN_PASSWORD=change-me
SEED_TEACHER_EMAIL=teacher@arohon.ai
SEED_TEACHER_PASSWORD=change-me
SEED_STUDENT_EMAIL=student@arohon.ai
SEED_STUDENT_PASSWORD=change-me
SEED_FREE_EMAIL=free@arohon.ai
SEED_FREE_PASSWORD=change-me
